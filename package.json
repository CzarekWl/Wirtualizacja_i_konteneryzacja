{
  "name": "job-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Distributed job processing system (API + queue workers)",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.8.0",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @jobs/shared --filter @jobs/api --filter @jobs/worker dev",
    "dev:api": "pnpm --parallel --filter @jobs/shared --filter @jobs/api dev",
    "dev:worker": "pnpm --parallel --filter @jobs/shared --filter @jobs/worker dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b && tsc -p tsconfig.eslint.json",
    "lint": "eslint \"apps/*/src/**/*.ts\" \"packages/*/src/**/*.ts\" vitest.config.ts eslint.config.js --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:ci": "pnpm audit --audit-level=high --ignore-registry-errors"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
